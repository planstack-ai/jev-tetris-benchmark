# Jev: choose one connection method.
# Vercel AI Gateway (recommended for the default setup)
AI_GATEWAY_API_KEY=

# Or connect directly to TypeSafe AI
TYPESAFE_API_KEY=
TETRIS_JEV_MODEL=jev-latest

# Optional comparison model. Without this key, the Haiku lane reports an API error
# while the Jev lane can still run.
ANTHROPIC_API_KEY=
TETRIS_HAIKU_MODEL=claude-haiku-4-5-20251001
